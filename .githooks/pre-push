#!/bin/sh
# 푸시 전 품질 게이트 — CI 와 같은 검사를 로컬에서 먼저 돌린다.
#
# 왜 있나: 적색을 원격까지 들고 가지 않기 위해서다. 같은 검사가 CI 에서도
# 돌지만(2026-08-30 push 트리거 정상화 확인), 원격은 러너 기동·의존성 설치가
# 더해져 로컬보다 느리므로 여기서 먼저 거르는 편이 빠르다.
#
# 한계(알고 쓰는 것): 검사 대상은 **작업트리**이지 푸시되는 커밋이 아니다.
# git 의 editable 설치가 이 트리를 가리키고 있어 임시 워크트리로 갈아끼울 수
# 없기 때문이다. 그래서 둘이 어긋날 수 있는 경우 — 트리가 더럽거나, HEAD 가
# 아닌 커밋을 푸시할 때 — 아래에서 경고를 띄운다. 그때의 통과는 '지금 이
# 트리'에 대한 것이지 푸시되는 커밋에 대한 보증이 아니다.
#
# 설치: make hooks   (git config core.hooksPath .githooks)
# 건너뛰기: git push --no-verify   (급할 때만)

set -e

# git 은 훅 stdin 으로 `<local-ref> <local-sha> <remote-ref> <remote-sha>` 를 준다.
#   - 브랜치 삭제(로컬 sha 가 0)만 있는 푸시면 검사할 게 없다.
#   - 로컬 sha 가 HEAD 와 다르면 검사 대상(작업트리)과 푸시 대상이 다른 커밋이다.
head_sha=$(git rev-parse HEAD 2>/dev/null || true)
only_deletes=1
saw_ref=0
pushes_other=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "$local_sha" ] && continue
    saw_ref=1
    case "$local_sha" in
        *[!0]*)
            only_deletes=0
            if [ "$local_sha" != "$head_sha" ]; then
                pushes_other=1
            fi
            ;;
    esac
done
if [ "$saw_ref" -eq 1 ] && [ "$only_deletes" -eq 1 ]; then
    echo "[pre-push] 브랜치 삭제만 있는 푸시 — 검사 생략."
    exit 0
fi

if [ -n "$(git status --porcelain)" ]; then
    echo "[pre-push] ⚠ 작업트리에 커밋되지 않은 변경이 있습니다."
    echo "[pre-push]   아래 결과는 '현재 트리' 기준이며, 푸시되는 커밋의 보증이 아닙니다."
fi
if [ "$pushes_other" -eq 1 ]; then
    echo "[pre-push] ⚠ 푸시하는 커밋이 현재 HEAD 가 아닙니다."
    echo "[pre-push]   아래 결과는 '현재 트리' 기준이며, 푸시되는 커밋의 보증이 아닙니다."
fi

PY="${VENV:-.venv}/bin/python"
if [ ! -x "$PY" ]; then
    echo "[pre-push] 게이트를 돌릴 수 없습니다: $PY 가 없습니다."
    echo "[pre-push] 'make install' 로 환경을 만든 뒤 다시 푸시하세요."
    echo "[pre-push] (검사 없이 밀어야 한다면 git push --no-verify)"
    exit 1
fi

echo "[pre-push] lint (ruff)"
"$PY" -m ruff check liot tests scripts

echo "[pre-push] typecheck (mypy)"
"$PY" -m mypy

# 커버리지 하한은 pyproject.toml [tool.coverage.report] fail_under 가 단일 원천.
echo "[pre-push] test + coverage floor"
"$PY" -m pytest -q --cov --cov-report=

echo "[pre-push] secret scan"
./scripts/secret_scan.sh

echo "[pre-push] 통과 — 푸시를 진행합니다."
